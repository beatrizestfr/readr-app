# Example environment variables for the Readr backend.
# Spring Boot does NOT load this file automatically: set these variables in
# your shell or IDE run configuration before starting the server (see README).
# Never commit real values.

# MySQL user and password for the local "app_tfg" database
DB_USERNAME=root
DB_PASSWORD=change-me

# Google Books API key (https://console.cloud.google.com/ > APIs & Services > Credentials)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
